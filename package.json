{
  "name": "chaos-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "voice:cards": "node --experimental-strip-types --no-warnings tools/voice/cards.mjs",
    "voice:collect": "node --experimental-strip-types --no-warnings tools/voice/collect.mjs",
    "voice:gen": "node --experimental-strip-types --no-warnings tools/voice/generate.mjs",
    "voice:compare": "node --experimental-strip-types --no-warnings tools/voice/compare.mjs",
    "voice:setup": "node --experimental-strip-types --no-warnings tools/voice/setup.mjs",
    "dev": "vite",
    "dev-playgama": "vite --mode playgama",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev:poki": "vite  --mode poki",
    "build:crazy-web": "vite build --mode crazy-web --base=./ ",
    "build:wavedash": "vite build --mode wavedash --base=./ --outDir=wavedash-dist && wavedash build push",
    "build:itch": "vite build --mode itch --base=./ && node scripts/pack-zip.mjs itch",
    "build:glitch": "vite build --mode glitch --base=./ && node scripts/pack-zip.mjs glitch",
    "build:playgama": "vite build --mode playgama --base=./ && node tools/playgama-release/release.mjs",
    "playgama:gates": "node tools/playgama-release/release.mjs --gates-only",
    "playgama:audit": "node scripts/youtube-fit-audit.mjs --root . --dist dist-playgama/game --zip dist-playgama/chaos-machine-playgama.zip --initial-extra assets,js --md dist-playgama/youtube-fit-report.md --json dist-playgama/youtube-fit.json",
    "build:gamepix": "vite build --mode gamepix --base=./ && node scripts/pack-zip.mjs gamepix",
    "build:gamemonetize": "vite build --mode gamemonetize --base=./ && node scripts/pack-zip.mjs gamemonetize",
    "build:yandex": "vite build --mode yandex --base=./ && node scripts/pack-zip.mjs yandex",
    "build:poki": "vite build --mode poki --base=./ && node tools/poki-deploy/pack.mjs",
    "deploy:poki": "node tools/poki-deploy/deploy.mjs",
    "deploy:playgama": "node tools/playgama-deploy/deploy.mjs",
    "build-github-main": "vite build --base=/chaos-machine/ --outDir=dist",
    "build-github-develop": "vite build --base=/chaos-machine/develop/ --outDir=dist/develop",
    "deploy": "vite build && surge dist/ --domain chaos-machine.surge.sh",
    "validated-build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc --build",
    "perf:ab": "node scripts/perf-ab.mjs",
    "perf:mission": "node scripts/perf-mission.mjs",
    "perf:builds": "node scripts/perf-builds.mjs",
    "qa:portal": "node scripts/portal-qa.mjs",
    "qa:xbrowser": "node scripts/xbrowser.mjs",
    "compress-folder": "node scripts/compress-images.mjs",
    "compress-bench": "node scripts/image-compress-bench.mjs",
    "compress-folder-with-backup": "node scripts/compress-images.mjs public/images --max-effort --backup-dir public-backup",
    "preview:video": "node tools/preview-video/record.mjs",
    "cinematic-trailer": "node tools/preview-video/trailer/build.mjs",
    "art:desk": "node tools/art-desk/server.mjs",
    "art:prompts": "node --import ./tools/ts-resolve.mjs tools/art-prompts.mjs",
    "slice-sheets": "node tools/slice-sheets.mjs",
    "art:promotion": "node --import ./tools/ts-resolve.mjs tools/art-promotion.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "art:logo": "node scripts/render-logo.mjs",
    "leaderboard:snapshot": "node scripts/leaderboard-snapshot.mjs",
    "leaderboard:seed": "node scripts/leaderboard-seed.mjs"
  },
  "dependencies": {
    "@playgama/bridge": "^2.2.0",
    "@vueuse/core": "^14.2.1",
    "@wvdsh/sdk-js": "^0.0.38",
    "lodash.clonedeep": "^4.5.0",
    "three": "^0.186.0",
    "vue": "^3.5.29",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@napi-rs/image": "^1.14.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^24.11.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/language-plugin-pug": "^3.2.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.8",
    "pug": "^3.0.3",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "sharp": "^0.35.4",
    "ssim.js": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^25.5.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
